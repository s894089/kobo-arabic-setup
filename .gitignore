# Device backups — created at runtime, never publish
backups/

# The book collection — 2.7 GB, and three files exceed GitHub's 100 MB
# per-file hard limit. Share it on a disk or cloud drive, not through git.
library/

# Personal library reorganisation — specific to one person's books
tools/library-plan.json
tools/*.log

# Personal data, in case it is ever copied into the payload by mistake
payload/.adds/koreader/settings/*.sqlite3
payload/.adds/koreader/settings/*.sqlite3-shm
payload/.adds/koreader/settings/*.sqlite3-wal
payload/.adds/koreader/settings/lookup_history.lua
payload/.adds/koreader/settings/wikipedia_history.lua
payload/.adds/koreader/settings/battery_stats.lua*
payload/.adds/koreader/settings/koinsight.lua*
payload/.adds/koreader/history.lua
payload/.adds/koreader/clipboard/
payload/.adds/koreader/cache/
payload/.adds/koreader/screenshots/
payload/.adds/koreader/crash.log

